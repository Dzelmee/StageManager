generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Band {
  id         Int         @id @default(autoincrement())
  name       String
  genre      String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  shows      Show[]
  songs      Song[]
  members    BandMember[]
  equipment  Equipment[]
  setlists   Setlist[]
}

model Show {
  id          Int       @id @default(autoincrement())
  name        String
  venue       String
  city        String?
  date        DateTime
  showTime    String?
  loadIn      String?
  soundcheck  String?
  duration    Int?
  status      String    @default("Planejado")
  notes       String?

  bandId      Int
  band        Band      @relation(fields: [bandId], references: [id])

  setlists    Setlist[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Song {
  id         Int       @id @default(autoincrement())
  title      String
  artist     String?
  bpm        Int?
  key        String?
  tuning     String?
  duration   Int?
  status     String    @default("Pronta")

  bandId     Int
  band       Band      @relation(fields: [bandId], references: [id])

  setlistSongs SetlistSong[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Setlist {
  id         Int       @id @default(autoincrement())
  name       String

  bandId     Int
  band       Band      @relation(fields: [bandId], references: [id])

  showId     Int?
  show       Show?     @relation(fields: [showId], references: [id])

  songs      SetlistSong[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model SetlistSong {
  id         Int      @id @default(autoincrement())
  position   Int

  setlistId  Int
  setlist    Setlist  @relation(fields: [setlistId], references: [id], onDelete: Cascade)

  songId     Int
  song       Song     @relation(fields: [songId], references: [id])

  @@unique([setlistId, position])
}

model BandMember {
  id         Int      @id @default(autoincrement())
  name       String
  role       String
  email      String?
  phone      String?

  bandId     Int
  band       Band     @relation(fields: [bandId], references: [id])

  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Equipment {
  id         Int      @id @default(autoincrement())
  name       String
  category   String?
  quantity   Int      @default(1)
  notes      String?

  bandId     Int
  band       Band     @relation(fields: [bandId], references: [id])

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/*
  ========================================
  CONTA E AUTENTICAÇÃO
  ========================================

  Dados pessoais ficam isolados nestas tabelas. Senhas são hash scrypt
  (nunca reversível) e tokens de sessão são armazenados apenas como hash.
*/

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String?
  emailVerified  Boolean   @default(false)
  avatarUrl      String?
  instrument     String?

  // Consentimento LGPD versionado.
  consentVersion String?
  consentedAt    DateTime?
  marketingOptIn Boolean   @default(false)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  memberships    BandMember[]
  sessions       Session[]
  oauthAccounts  OAuthAccount[]
  accountTokens  AccountToken[]
  authEvents     AuthEvent[]
}

model Session {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt     DateTime
  createdAt     DateTime @default(now())
  lastUsedAt    DateTime @default(now())

  // Guardamos apenas hashes, nunca IP/user-agent em texto puro.
  ipHash        String?
  userAgentHash String?

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model AccountToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      String
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  type      String
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}