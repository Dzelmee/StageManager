# Banco de dados
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stagemanager?schema=public

# URLs públicas (sem barra no final)
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3333

# Obrigatório em produção. Use um valor aleatório com 32+ bytes.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Em produção o cookie deve ser Secure (padrão quando NODE_ENV=production).
# COOKIE_SECURE=true

# Login social (opcional). Os botões só aparecem quando configurados.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Provedor de e-mail (ainda não implementado).
# Sem SMTP, os links de verificação/reset são impressos no console em dev.
# SMTP_URL=
